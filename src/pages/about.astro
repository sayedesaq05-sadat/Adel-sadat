---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
---

<Layout title="درباره من">
  <Nav />
  <main class="page-content">
    <section class="about-hero">
      <div class="about-container">
        <div class="about-image-wrapper">
          <div class="about-avatar">
            <span class="avatar-letter">ع</span>
          </div>
          <div class="avatar-glow"></div>
        </div>

        <h1 class="about-title">درباره من</h1>
        <p class="about-intro">
          من عادل سادات هستم — نویسنده، داستان‌سرا و انسانی که با کلمات زندگی می‌کند
        </p>
      </div>
    </section>

    <section class="about-details">
      <div class="details-container">
        <div class="detail-card">
          <div class="detail-icon">✨</div>
          <h3>چه کسی هستم؟</h3>
          <p>
            من عادل سادات هستم. کسی که معتقد است هر انسان داستان منحصر به فرد خودش را دارد.
            من تلاش می‌کنم این داستان‌ها را با زبانی ساده و صادقانه بیان کنم.
          </p>
        </div>

        <div class="detail-card">
          <div class="detail-icon">🎯</div>
          <h3>هدف من</h3>
          <p>
            هدفم ایجاد ارتباط واقعی با خوانندگان است. می‌خواهم هر کسی که نوشته‌های مرا می‌خواند،
            بخشی از خودش را در آن‌ها پیدا کند.
          </p>
        </div>

        <div class="detail-card">
          <div class="detail-icon">💡</div>
          <h3>الهام</h3>
          <p>
            از زندگی واقعی، از مردم، از لحظات کوچک و بزرگ الهام می‌گیرم.
            هر لحظه یک داستان است، فقط باید خوب گوش داد.
          </p>
        </div>

        <div class="detail-card">
          <div class="detail-icon">💜</div>
          <h3>ارزش‌ها</h3>
          <p>
            صداقت، احترام و همدلی سه ستون اصلی زندگی و کار من هستند.
            بدون این‌ها هیچ داستانی واقعی نیست.
          </p>
        </div>
      </div>
    </section>

    <section class="about-timeline">
      <div class="details-container">
        <h2 class="section-title">مسیر من</h2>
        <div class="timeline">
          <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-content">
              <h4>شروع</h4>
              <p>همه چیز از یک قلم و یک کاغذ شروع شد</p>
            </div>
          </div>
          <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-content">
              <h4>رشد</h4>
              <p>با هر داستان، دنیایم بزرگ‌تر شد</p>
            </div>
          </div>
          <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-content">
              <h4>امروز</h4>
              <p>همچنان در مسیر هستم و هر روز چیز جدیدی یاد می‌گیرم</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <p>ساخته شده با 💜 توسط عادل سادات</p>
  </footer>
</Layout>

<style>
  .about-hero {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 120px 2rem 3rem;
  }

  .about-container {
    max-width: 600px;
  }

  .about-image-wrapper {
    position: relative;
    display: inline-block;
    margin-bottom: 2rem;
  }

  .about-avatar {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background: var(--gradient-button);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 2;
    border: 3px solid var(--color-violet-light);
  }

  .avatar-letter {
    font-size: 3rem;
    font-weight: 900;
    color: var(--color-white);
  }

  .avatar-glow {
    position: absolute;
    top: -10px;
    left: -10px;
    right: -10px;
    bottom: -10px;
    border-radius: 50%;
    background: var(--color-violet);
    opacity: 0.3;
    filter: blur(20px);
    z-index: 1;
    animation: pulse 3s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 0.3; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.1); }
  }

  .about-title {
    font-size: 2.5rem;
    font-weight: normal;
    background: var(--gradient-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 1rem;
    font-family: var(--font-literary);
  }
  .about-intro {
    font-size: 1.15rem;
    color: var(--color-gray);
    line-height: 1.9;
  }

  .about-details {
    padding: 2rem 2rem 4rem;
  }

  .details-container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .detail-cards,
  .about-details .details-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
  }

  .detail-card {
    background: var(--gradient-card);
    border: 1px solid var(--color-card-border);
    border-radius: 20px;
    padding: 2rem;
    transition: all 0.3s ease;
  }

  .detail-card:hover {
    transform: translateY(-5px);
    border-color: var(--color-violet);
    box-shadow: 0 10px 30px rgba(147, 3, 197, 0.15);
  }

  .detail-icon {
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  .detail-card h3 {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-white);
    margin-bottom: 0.8rem;
  }

  .detail-card p {
    color: var(--color-gray);
    line-height: 1.8;
    font-size: 0.95rem;
  }

  .about-timeline {
    padding: 4rem 2rem;
  }

  .section-title {
    text-align: center;
    font-size: 2rem;
    font-weight: 800;
    background: var(--gradient-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 3rem;
  }

  .timeline {
    max-width: 600px;
    margin: 0 auto;
    position: relative;
    padding-right: 30px;
  }

  .timeline::before {
    content: '';
    position: absolute;
    right: 7px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--color-card-border);
  }

  .timeline-item {
    position: relative;
    padding: 0 2rem 2.5rem;
  }

  .timeline-item:last-child {
    padding-bottom: 0;
  }

  .timeline-dot {
    position: absolute;
    right: -27px;
    top: 5px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--color-violet);
    border: 3px solid var(--color-dark);
    box-shadow: 0 0 10px rgba(147, 3, 197, 0.5);
  }

  .timeline-content h4 {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-violet-light);
    margin-bottom: 0.3rem;
  }

  .timeline-content p {
    color: var(--color-gray);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .footer {
    text-align: center;
    padding: 2rem;
    border-top: 1px solid var(--color-card-border);
    position: relative;
    z-index: 1;
  }

  .footer p {
    color: var(--color-gray);
    font-size: 0.9rem;
  }

  @media (max-width: 640px) {
    .about-title {
      font-size: 2rem;
    }

    .about-details .details-container {
      grid-template-columns: 1fr;
    }
  }
</style>