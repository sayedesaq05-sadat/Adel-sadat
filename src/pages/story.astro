---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import { stories } from "../data/stories.js";
---

<Layout title="داستان">
  <Nav />
  <main class="page-content">
    <section class="story-hero">
      <div class="story-hero-content">
        <div class="story-hero-badge">📖</div>
        <h1 class="story-hero-title">داستان‌ها</h1>
        <p class="story-hero-subtitle">
          داستان‌هایی از زندگی، احساس و تجربه — هر کدام آینه‌ای از واقعیت
        </p>
        <div class="story-hero-stats">
          <div class="stat">
            <span class="stat-number">{stories.length}</span>
            <span class="stat-label">داستان</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat">
            <span class="stat-number">∞</span>
            <span class="stat-label">کلمه</span>
          </div>
        </div>
      </div>
    </section>

    <section class="stories-list">
      <div class="stories-container">
        {stories.map(function(story) {
          var num = String(story.id).padStart(2, '0');
          return (
            <a href={"/stories/" + story.id} class="story-card">
              <div class="story-card-number">{num}</div>
              <div class="story-card-content">
                <div class="story-card-top">
                  <h3 class="story-card-title">{story.title}</h3>
                  <div class="story-card-meta">
                    <span>📅 {story.date}</span>
                    <span>⏱ {story.readTime}</span>
                  </div>
                </div>
                <p class="story-card-excerpt">{story.excerpt}</p>
                <div class="story-card-bottom">
                  <div class="story-card-tags">
                    {story.tags.map(function(tag) {
                      return <span class="story-card-tag">{tag}</span>;
                    })}
                  </div>
                  <span class="story-card-read">ادامه داستان ←</span>
                </div>
              </div>
              <div class="story-card-accent"></div>
            </a>
          );
        })}
      </div>
    </section>

    <section class="story-cta">
      <div class="cta-container">
        <h2>داستان شما چیست؟</h2>
        <p>هر انسانی داستان خودش را دارد. داستان شما را بشنوم</p>
        <a href="/contact" class="cta-btn">بفرستید داستانم را ✦</a>
      </div>
    </section>
  </main>

  <footer class="footer">
    <p>ساخته شده با 💜 توسط عادل سادات</p>
  </footer>
</Layout>

<style>
  .story-hero {
    min-height: 50vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 120px 2rem 3rem;
  }

  .story-hero-content {
    max-width: 600px;
  }

  .story-hero-badge {
    font-size: 3rem;
    margin-bottom: 1rem;
  }

  .story-hero-title {
    font-size: 3rem;
    font-weight: 900;
    background: var(--gradient-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 1rem;
  }

  .story-hero-subtitle {
    color: var(--color-gray);
    font-size: 1.15rem;
    line-height: 1.9;
    margin-bottom: 2rem;
  }

  .story-hero-stats {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .stat-number {
    font-size: 1.8rem;
    font-weight: 900;
    background: var(--gradient-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .stat-label {
    font-size: 0.85rem;
    color: var(--color-gray);
  }

  .stat-divider {
    width: 1px;
    height: 40px;
    background: var(--color-card-border);
  }

  .stories-list {
    padding: 2rem 2rem 4rem;
  }

  .stories-container {
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .story-card {
    display: flex;
    gap: 1.5rem;
    background: var(--gradient-card);
    border: 1px solid var(--color-card-border);
    border-radius: 20px;
    padding: 2rem;
    transition: all 0.4s ease;
    position: relative;
    overflow: hidden;
  }

  .story-card:hover {
    transform: translateY(-5px);
    border-color: var(--color-violet);
    box-shadow: 0 10px 40px rgba(147, 3, 197, 0.15);
  }

  .story-card:hover .story-card-accent {
    transform: scaleX(1);
  }

  .story-card:hover .story-card-read {
    color: var(--color-violet-light);
    transform: translateX(-4px);
  }

  .story-card-number {
    font-size: 2.5rem;
    font-weight: 900;
    background: var(--gradient-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    flex-shrink: 0;
    min-width: 50px;
    line-height: 1;
    padding-top: 0.2rem;
  }

  .story-card-content {
    flex: 1;
    min-width: 0;
  }

  .story-card-top {
    margin-bottom: 0.8rem;
  }

  .story-card-title {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--color-white);
    margin-bottom: 0.5rem;
    line-height: 1.5;
  }

  .story-card-meta {
    display: flex;
    gap: 1rem;
    color: var(--color-gray);
    font-size: 0.8rem;
    flex-wrap: wrap;
  }

  .story-card-excerpt {
    color: var(--color-gray);
    font-size: 0.93rem;
    line-height: 1.8;
    margin-bottom: 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .story-card-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .story-card-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .story-card-tag {
    padding: 0.2rem 0.6rem;
    border-radius: 50px;
    font-size: 0.75rem;
    color: var(--color-violet-light);
    background: var(--color-card);
    border: 1px solid var(--color-card-border);
  }

  .story-card-read {
    color: var(--color-gray);
    font-size: 0.85rem;
    font-weight: 600;
    transition: all 0.3s ease;
    white-space: nowrap;
  }

  .story-card-accent {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--gradient-button);
    transform: scaleX(0);
    transition: transform 0.4s ease;
  }

  .story-cta {
    padding: 4rem 2rem;
    text-align: center;
  }

  .cta-container {
    max-width: 500px;
    margin: 0 auto;
    padding: 3rem;
    background: var(--gradient-card);
    border: 1px solid var(--color-card-border);
    border-radius: 24px;
  }

  .cta-container h2 {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-white);
    margin-bottom: 0.8rem;
  }

  .cta-container p {
    color: var(--color-gray);
    margin-bottom: 1.5rem;
    line-height: 1.7;
  }

  .cta-btn {
    display: inline-block;
    padding: 0.8rem 2rem;
    background: var(--gradient-button);
    color: var(--color-white);
    border-radius: 16px;
    font-weight: 600;
    font-family: var(--font-main);
    transition: all 0.3s ease;
    box-shadow: 0 4px 20px rgba(147, 3, 197, 0.4);
  }

  .cta-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 30px rgba(147, 3, 197, 0.6);
  }

  .footer {
    text-align: center;
    padding: 2rem;
    border-top: 1px solid var(--color-card-border);
    position: relative;
    z-index: 1;
  }

  .footer p {
    color: var(--color-gray);
    font-size: 0.9rem;
  }

  @media (max-width: 640px) {
    .story-card {
      flex-direction: column;
      gap: 0.8rem;
    }

    .story-card-number {
      font-size: 2rem;
    }

    .story-card-excerpt {
      -webkit-line-clamp: 3;
    }

    .story-card-bottom {
      flex-direction: column;
      align-items: flex-start;
    }

    .story-hero-title {
      font-size: 2.2rem;
    }
  }
</style>